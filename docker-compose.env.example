# Copy this file to ".env" in the same directory as docker-compose.yml,
# fill in real values, then run: docker compose up -d
#
# IMPORTANT: do NOT wrap values in quotes here, even though the app's own
# .env.example uses them. Node's dotenv strips quotes automatically; Docker's
# env-file parsing does not, so a quoted value like MONGO_URI="mongodb+srv://..."
# gets passed to the app literally (quote marks and all) and breaks Mongoose's
# connection-string parsing at container startup.

# --- Which images to pull, and which host ports to expose ---
BACKEND_IMAGE=ghcr.io/s-k-jha/guideup-api:latest
FRONTEND_IMAGE=ghcr.io/s-k-jha/guideup-frontend:latest
BACKEND_PORT=5000
FRONTEND_PORT=80

# --- Backend secrets (same values as guideup-api/.env.example) ---
MONGO_URI=mongodb+srv://root:mypassword@guideup.werce4l.mongodb.net/?appName=guideup
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_admin_password
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
EMAIL_USER=connect.azsolutions@gmail.com
EMAIL_PASS=your_app_password
RESEND_API_KEY=

# guideup.in in production; must match wherever the frontend container is served from
FRONTEND_URL=https://guideup.in
ALLOWED_ORIGINS=https://guideup.in

# AI Mentor Chat (optional) — leave blank to disable AI-handled chats
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-4o-mini
