PORT=5000
MONGO_URI=mongodb+srv://root:mypassword@guideup.werce4l.mongodb.net/?appName=guideup
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
EMAIL_USER=connect.azsolutions@gmail.com
EMAIL_PASS=your_app_password
JWT_SECRET=123456
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=admin_password_change_this
NODE_ENV=development

# AI Mentor Chat (optional) — set either key to let admin enable the
# "AI Mentor Chat" toggle at /admin/chat-orders. If both are set, Anthropic
# is used by default; override with AI_PROVIDER.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-4o-mini

# Cloudinary (required for the admin Notes upload feature)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
